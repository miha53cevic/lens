{
  "name": "lens",
  "version": "0.5.0",
  "private": true,
  "description": "The code review tool for the agentic era: folds the code that carries no review signal, and has your own agent summarize a change and answer questions about it",
  "type": "module",
  "bin": {
    "lens": "src/cli-app/cli.ts"
  },
  "main": "dist/main.mjs",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "lens": "bun src/cli-app/cli.ts",
    "compile": "bun scripts/compile.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json && tsc -p tsconfig.desktop.json",
    "format": "prettier --write src test scripts forge.config.ts",
    "format:check": "prettier --check src test scripts forge.config.ts",
    "test": "bun run typecheck && bun run format:check && bun test --isolate test/",
    "app": "bun --bun electron-forge start",
    "app:dist": "bun --bun electron-forge package",
    "app:smoke": "bun scripts/smoke.ts",
    "app:icons": "bun scripts/icons.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/dom": "^10.4.2",
    "@types/bun": "^1.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "bun-plugin-tailwind": "0.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "1.48.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  }
}
