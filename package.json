{
  "name": "lens",
  "version": "0.1.0",
  "private": true,
  "description": "A reading lens for AI-generated code: statically folds review-irrelevant regions (imports, doc comments, guards, logging, defensive boilerplate)",
  "type": "module",
  "bin": {
    "lens": "src/cli.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "lens": "node src/cli.ts",
    "install-cli": "npm link",
    "uninstall-cli": "npm unlink -g lens",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json",
    "format": "prettier --write src/render/web/client test/viewer-page.test.ts test/viewer.test.ts test/fixtures/viewerRepo.ts",
    "format:check": "prettier --check src/render/web/client test/viewer-page.test.ts test/viewer.test.ts test/fixtures/viewerRepo.ts",
    "test": "npm run typecheck && npm run format:check && node --test test/*.test.ts",
    "install-skill": "node scripts/skills.ts install",
    "uninstall-skill": "node scripts/skills.ts uninstall"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
